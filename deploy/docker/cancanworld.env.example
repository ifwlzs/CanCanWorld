# Docker 镜像和宿主机端口；修改后执行 docker compose up -d --build 即可。
CANCANWORLD_IMAGE=cancanworld:latest
CANCANWORLD_VERSION=development
CANCANWORLD_PORT=3080

# 默认启用 Compose 内置 MySQL 8；使用外部 MySQL 时将此项留空并修改 DATABASE_HOST。
COMPOSE_PROFILES=bundled-db
MYSQL_ROOT_PASSWORD=CHANGE_TO_A_RANDOM_MYSQL_ROOT_PASSWORD
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=db_cancanworld
DATABASE_USER=cancanworld
DATABASE_PASSWORD=CHANGE_TO_A_RANDOM_MYSQL_PASSWORD
DATABASE_POOL_SIZE=10

# Bun 仅在容器内部监听 3081，浏览器统一访问 Nginx 暴露的 3080 端口。
SERVER_HOST=127.0.0.1
SERVER_PORT=3081
FRONTEND_ORIGIN=http://SERVER_IP:3080

# 两个应用密钥必须不同，且分别至少使用 32 个随机字符。
SESSION_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
CSRF_SECRET=CHANGE_TO_ANOTHER_32_RANDOM_CHARACTERS
SESSION_TTL_SECONDS=604800

# 导入和后台任务限制沿用生产默认值，可按服务器资源调整。
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_MAX_NODES=100000
IMPORT_MAX_DEPTH=256
IMPORT_JOB_TTL_SECONDS=86400
LINK_CHECK_INTERVAL_SECONDS=1800
LINK_CHECK_CONCURRENCY=10
LINK_CHECK_PER_HOST_CONCURRENCY=2
LINK_CHECK_TIMEOUT_MS=10000
LINK_CHECK_MAX_REDIRECTS=5
LINK_CHECK_MAX_RESPONSE_BYTES=65536
LINK_CHECK_ALLOWED_PORTS=80,443
LINK_CHECK_ALLOWED_CIDRS=
LINK_CHECK_HISTORY_RETENTION_DAYS=30

# 数据库初始化期间容器会自动重试迁移，超过次数后退出并由 Docker 记录日志。
MIGRATION_RETRIES=60
MIGRATION_RETRY_SECONDS=2
LOG_LEVEL=info
NODE_ENV=production
