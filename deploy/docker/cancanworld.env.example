# 要运行的镜像名称；使用本地构建时可改成自己的标签。
CANCANWORLD_IMAGE=cancanworld:latest
# 发布版本标识；本地构建时用于镜像构建参数和日志追踪。
CANCANWORLD_VERSION=development
# 宿主机对外提供 Web 服务的端口，容器内部固定使用 3080。
CANCANWORLD_PORT=3080

# 外部 MySQL 主机；数据库在 Docker 宿主机时填写 host.docker.internal。
DATABASE_HOST=host.docker.internal
# 外部 MySQL TCP 端口，通常为 3306。
DATABASE_PORT=3306
# 应用使用的数据库名称，需提前创建。
DATABASE_NAME=CHANGE_ME
# 应用连接数据库的账号，需提前创建并授予迁移权限。
DATABASE_USER=CHANGE_ME
# 应用连接数据库的密码，只保存在部署机，不提交 Git。
DATABASE_PASSWORD=CHANGE_ME
# MySQL 连接池最大连接数，按数据库承载能力调整。
DATABASE_POOL_SIZE=10

# Bun 后端绑定地址；容器内仅允许 Nginx 通过回环地址访问。
SERVER_HOST=127.0.0.1
# Bun 后端内部端口，不能与 Nginx 的 3080 混用。
SERVER_PORT=3081
# 前端对外访问源，用于 API 跨域校验；同源访问时填写常用地址即可。
FRONTEND_ORIGIN=http://SERVER_IP:3080

# 会话签名和加密相关的应用密钥；可由部署脚本随机生成，必须至少 32 字节。
SESSION_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
# CSRF 会话校验密钥；必须与 SESSION_SECRET 不同，可由部署脚本随机生成。
CSRF_SECRET=CHANGE_TO_ANOTHER_32_RANDOM_CHARACTERS
# 登录会话有效期，单位为秒。
SESSION_TTL_SECONDS=604800

# 书签导入文件最大字节数。
IMPORT_MAX_FILE_BYTES=10485760
# 单次导入允许的最大节点数量。
IMPORT_MAX_NODES=100000
# 导入目录允许的最大嵌套深度。
IMPORT_MAX_DEPTH=256
# 导入任务记录保留时间，单位为秒。
IMPORT_JOB_TTL_SECONDS=86400
# 链接检测全局并发数。
LINK_CHECK_CONCURRENCY=10
# 同一主机的链接检测并发数。
LINK_CHECK_PER_HOST_CONCURRENCY=2
# 单个链接检测超时时间，单位为毫秒。
LINK_CHECK_TIMEOUT_MS=10000
# 自动跟随重定向的最大次数。
LINK_CHECK_MAX_REDIRECTS=5
# 链接检测读取响应体的最大字节数。
LINK_CHECK_MAX_RESPONSE_BYTES=65536
# 允许检测的目标端口列表，逗号分隔。
LINK_CHECK_ALLOWED_PORTS=80,443
# 允许检测的内网 CIDR 列表，逗号分隔；为空表示不额外放行内网地址。
LINK_CHECK_ALLOWED_CIDRS=
# 链接检测历史保留天数。
LINK_CHECK_HISTORY_RETENTION_DAYS=30

# 数据库迁移最大重试次数。
MIGRATION_RETRIES=60
# 数据库迁移重试间隔，单位为秒。
MIGRATION_RETRY_SECONDS=2
# 服务日志级别，可选 fatal、error、warn、info、debug、trace。
LOG_LEVEL=info
# 运行环境标识，生产部署保持 production。
NODE_ENV=production
